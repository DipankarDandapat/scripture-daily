<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background. The supplied ic_launcher_background.png is solid near-white, which makes the
  pale-gold lotus foreground almost invisible. This gradient is sampled from WisdomOne_1024_master.png
  (dark purple edges, warm glow behind the lotus).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="46"
                android:gradientRadius="74">
                <item android:offset="0.0" android:color="#8F3544" />
                <item android:offset="0.4" android:color="#5C1A47" />
                <item android:offset="1.0" android:color="#210A3C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
