<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="today_verse"
        android:enabled="true"
        android:icon="@drawable/shortcut_today"
        android:shortcutShortLabel="@string/shortcut_today_short"
        android:shortcutLongLabel="@string/shortcut_today_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.scripturedaily"
            android:targetClass="com.scripturedaily.MainActivity">
            <extra android:name="shortcut_tab" android:value="Home" />
        </intent>
    </shortcut>

    <shortcut
