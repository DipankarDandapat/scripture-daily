# Copy to backend/.env for local development. Never commit real secrets.
SD_APP_NAME=WisdomOne API
SD_ENVIRONMENT=development
SD_DATABASE_URL=sqlite:///./scripture_daily.db
SD_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SD_JWT_ALGORITHM=HS256
SD_ACCESS_TOKEN_MINUTES=0
SD_ADMIN_TOKEN=replace-with-a-long-random-admin-token
SD_CORS_ORIGINS=*
# Swagger UI credentials — change before deploying
SD_SWAGGER_USERNAME=apiadmin
SD_SWAGGER_PASSWORD=replace-with-a-strong-password
