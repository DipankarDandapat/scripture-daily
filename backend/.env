# Copy to .env and replace secrets before deployment.
SD_APP_NAME=WisdomOne API
SD_ENVIRONMENT=development
# SQLite (default for local dev — no Docker needed)
SD_DATABASE_URL=sqlite:///./scripture_daily.db
# Uncomment below and set credentials to switch to PostgreSQL
#SD_DATABASE_URL=postgresql+psycopg://scripture:scripture@localhost:5432/scripture
#SD_DATABASE_URL=mysql+pymysql://uhuxwwjzfw_Dipankar1994:Dipankar1994%40%40@localhost:3306/uhuxwwjzfw_scripture_daily
SD_JWT_SECRET=replace-with-a-long-random-secret
SD_ACCESS_TOKEN_MINUTES=10080
SD_ADMIN_TOKEN=WisdomOne@2024 #SecureAdmin
SD_CORS_ORIGINS=*
# Path to your Firebase service account JSON (download from Firebase Console → Project Settings → Service accounts)
SD_FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
